+// The core calls this while paused. The decoder can still run ahead, so only
+// return an unambiguous exact presented-PTS match, never the newest frame.
+struct mp_image *mp_decoder_wrapper_source_raster(struct mp_decoder_wrapper *d,
+                                                  double pts)
+{
+    struct priv *p = d->f->priv;
+    struct mp_image *result = NULL;
+    int matches = 0;
+    thread_lock(p);
+    bool allowed = p->opts->aagedal_decoder_raster &&
+        !p->fixed_format.aagedal_transform_invalid &&
+        p->fixed_format.rotate >= 0 && p->fixed_format.rotate < 360 &&
+        p->fixed_format.rotate % 90 == 0 &&
+        p->fixed_format.p_w > 0 &&
+        p->fixed_format.p_w == p->fixed_format.p_h &&
+        p->fixed_format.crop.x0 == 0 && p->fixed_format.crop.y0 == 0 &&
+        p->fixed_format.crop.x1 == p->fixed_format.w &&
+        p->fixed_format.crop.y1 == p->fixed_format.h &&
+        p->opts->video_rotate == 0 && p->opts->movie_aspect == -2 &&
+        p->opts->aspect_method == 2 && p->opts->correct_pts &&
+        p->opts->fps_override == 0 && p->play_dir == 1;
+    thread_unlock(p);
+    if (!allowed)
+        return NULL;
+    mp_mutex_lock(&p->cache_lock);
+    if (p->source_pts_ambiguous) {
+        mp_mutex_unlock(&p->cache_lock);
+        return NULL;
+    }
+    for (int n = 0; n < 4; n++) {
+        if (p->source_rasters[n] && p->source_rasters[n]->pts == pts) {
+            matches++;
+            if (!result)
+                result = mp_image_new_ref(p->source_rasters[n]);
+        }
+    }
+    mp_mutex_unlock(&p->cache_lock);
+    if (matches != 1)
+        mp_image_unrefp(&result);
+    return result;
+}
