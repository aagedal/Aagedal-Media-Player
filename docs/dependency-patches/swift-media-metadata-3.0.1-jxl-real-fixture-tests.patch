     // MARK: - JPEG XL Reading and Writing
 
+    // Despite its filename, this real fixture contains a complete JXL container.
+    // Extract its authentic jxlc payload to exercise the bare-codestream contract.
+    private func realJXLCodestream() throws -> (container: Data, codestream: Data) {
+        let url = testImageURL("ShortPlantHDR_seq_000001.jxl")
+        try skipIfMissing(url)
+        let container = try Data(contentsOf: url)
+        let parsed = try JXLParser.parse(container)
+        XCTAssertTrue(parsed.isContainer)
+        let streams = parsed.boxes.filter { $0.type == "jxlc" }
+        XCTAssertEqual(streams.count, 1)
+        XCTAssertFalse(parsed.boxes.contains { $0.type == "jxlp" })
+        let codestream = try XCTUnwrap(streams.first?.data)
+        XCTAssertTrue(codestream.starts(with: [0xff, 0x0a]))
+        return (container, codestream)
+    }
+
+    func testRealJXLContainerWritePreservesCodestream() throws {
+        let fixture = try realJXLCodestream()
+        let metadata = try ImageMetadata.read(from: fixture.container)
+        XCTAssertEqual(metadata.format, .jpegXL)
+        let written = try metadata.writeToData()
+        let parsed = try JXLParser.parse(written)
+        XCTAssertTrue(parsed.isContainer)
+        XCTAssertEqual(parsed.boxes.filter { $0.type == "jxlc" }.count, 1)
+        XCTAssertEqual(parsed.findBox("jxlc")?.data, fixture.codestream)
+    }
