+static bool ca_get_preferred_stereo_chmap(struct ao *ao, AudioDeviceID device,
+                                          int channel_count,
+                                          struct mp_chmap *out_map)
+{
+    UInt32 stereo[2];
+    UInt32 size = sizeof(stereo);
+    AudioObjectPropertyAddress address = {
+        kAudioDevicePropertyPreferredChannelsForStereo,
+        kAudioObjectPropertyScopeOutput,
+        kAudioObjectPropertyElementMain,
+    };
+    OSStatus err = AudioObjectGetPropertyData(device, &address, 0, NULL,
+                                              &size, stereo);
+    if (err != noErr || size != sizeof(stereo) ||
+        !stereo[0] || !stereo[1] ||
+        stereo[0] > channel_count || stereo[1] > channel_count ||
+        stereo[0] == stereo[1])
+    {
+        MP_VERBOSE(ao, "could not get preferred stereo channels: %u, %u\n",
+                   stereo[0], stereo[1]);
+        return false;
+    }
+
+    *out_map = (struct mp_chmap){.num = channel_count};
+    for (int n = 0; n < out_map->num; n++)
+        out_map->speaker[n] = MP_SPEAKER_ID_NA;
+    out_map->speaker[stereo[0] - 1] = MP_SPEAKER_ID_FL;
+    out_map->speaker[stereo[1] - 1] = MP_SPEAKER_ID_FR;
+    MP_VERBOSE(ao, "preferred stereo channels: %u, %u\n",
+               stereo[0], stereo[1]);
+    return true;
+}
+
+bool ca_get_output_chmap(struct ao *ao, AudioUnit unit, AudioDeviceID device,
+                        struct mp_chmap *out_map)
+{
+    AudioStreamBasicDescription asbd;
+    UInt32 size = sizeof(asbd);
+    OSStatus err = AudioUnitGetProperty(unit, kAudioUnitProperty_StreamFormat,
+                                        kAudioUnitScope_Output, 0, &asbd, &size);
+    CHECK_CA_ERROR("could not get output unit stream format");
+    if (!asbd.mChannelsPerFrame || asbd.mChannelsPerFrame > MP_NUM_CHANNELS) {
+        MP_ERR(ao, "unsupported output channel count: %u\n", asbd.mChannelsPerFrame);
+        return false;
+    }
+
+    // query preferred stereo channel if only has two channels
+    if (asbd.mChannelsPerFrame == 2 &&
+        ca_get_preferred_stereo_chmap(ao, device, 2, out_map))
+    {
+        return true;
+    }
+
+    Boolean writable;
+    err = AudioUnitGetPropertyInfo(unit, kAudioUnitProperty_AudioChannelLayout,
+                                   kAudioUnitScope_Output, 0, &size, &writable);
+    if (err == noErr) {
+        AudioChannelLayout *layout = talloc_zero_size(NULL, size);
+        err = AudioUnitGetProperty(unit, kAudioUnitProperty_AudioChannelLayout,
+                                   kAudioUnitScope_Output, 0, layout, &size);
+        bool valid = err == noErr &&
+                     ca_layout_to_mp_chmap(ao, layout, out_map) &&
+                     out_map->num == asbd.mChannelsPerFrame;
+        talloc_free(layout);
+        if (valid)
+            return true;
+    }
+
+    *out_map = (struct mp_chmap){.num = asbd.mChannelsPerFrame};
+    for (int n = 0; n < out_map->num; n++)
+        out_map->speaker[n] = MP_SPEAKER_ID_NA;
+    if (out_map->num == 1) {
+        *out_map = (struct mp_chmap)MP_CHMAP_INIT_MONO;
+        return true;
+    }
+
+    if (!ca_get_preferred_stereo_chmap(ao, device, out_map->num, out_map)) {
+        MP_ERR(ao, "invalid output device stereo channels\n");
+        return false;
+    }
+    return true;
+
+coreaudio_error:
+    return false;
+}
+
+bool ca_select_channel_map(struct mp_chmap *input, const struct mp_chmap *output,
+                           SInt32 *map)
+{
+    if (!mp_chmap_is_valid(output) || mp_chmap_is_unknown(output))
+        return false;
+
+    struct mp_chmap_sel sel = {0};
+    struct mp_chmap fallback = *output;
+    mp_chmap_remove_na(&fallback);
+    mp_chmap_sel_add_map(&sel, &fallback);
+    for (int n = 0; n < fallback.num; n++)
+        mp_chmap_sel_add_speaker(&sel, fallback.speaker[n]);
+
+    if (sel.speakers[MP_SPEAKER_ID_FL] && sel.speakers[MP_SPEAKER_ID_FR])
+        mp_chmap_sel_add_map(&sel, &(struct mp_chmap)MP_CHMAP_INIT_STEREO);
+    if (!mp_chmap_sel_adjust(&sel, input))
+        return false;
+
+    int reorder[MP_NUM_CHANNELS];
+    mp_chmap_get_reorder(reorder, input, output);
+    for (int n = 0; n < output->num; n++)
+        map[n] = reorder[n];
+    return true;
+}
